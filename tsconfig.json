{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Five unused imports had drifted in before this was turned on, two of
    // them from a module that only re-exports the names.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // The node:test suites import with an explicit .ts extension, which is
    // what Node's ESM loader resolves under --experimental-strip-types.
    "allowImportingTsExtensions": true,
    // Those suites also import node: builtins. SDK 54 pulled @types/node in
    // transitively; SDK 57 does not, so it is declared here explicitly.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "design", "dist"]
}
